{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  BENEFITS LIST

  A card with a heading and a list of benefits (marked with numbers or icons) beside an image. The card takes the
  section's color scheme, so it can sit as a panel on the page background.
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .benefits-list {
    display: grid;
    gap: 2rem;
    padding: 2rem 1.5rem;
  }

  #shopify-section-{{ section.id }} .benefits-list__content {
    display: grid;
    gap: 2rem;
    align-content: center;
  }

  #shopify-section-{{ section.id }} .benefits-list__items {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .benefits-list__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: .375rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .benefits-list__marker {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--rounded-full);
    background: rgb(var(--text-color));
    color: rgb(var(--background));
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .benefits-list__marker--icon {
    background: none;
    color: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .benefits-list__text {
    grid-column: 2;
    opacity: .75;
  }

  #shopify-section-{{ section.id }} .benefits-list__media {
    align-self: center;
    overflow: hidden;
    {%- if section.settings.image_aspect_ratio == 'fill' %}
      aspect-ratio: 4 / 3;
    {%- else %}
      aspect-ratio: {{ section.settings.image_aspect_ratio }};
    {%- endif %}
  }

  #shopify-section-{{ section.id }} .benefits-list__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .benefits-list {
      padding: 3rem;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .benefits-list {
      gap: 4rem;
      padding: 2.5rem 2.5rem 2.5rem 5rem;
    }

    #shopify-section-{{ section.id }} .benefits-list--with-image {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .benefits-list--image-start {
      padding: 2.5rem 5rem 2.5rem 2.5rem;
    }

    #shopify-section-{{ section.id }} .benefits-list--image-start .benefits-list__media {
      order: -1;
    }

    {%- if section.settings.image_aspect_ratio == 'fill' %}
      /* Fill the full height of the card, whatever the content length */
      #shopify-section-{{ section.id }} .benefits-list__media {
        align-self: stretch;
        aspect-ratio: auto;
      }
    {%- endif %}

    #shopify-section-{{ section.id }} .benefits-list:not(.benefits-list--with-image) {
      padding: 5rem;
    }

    #shopify-section-{{ section.id }} .benefits-list__content {
      padding-block: 2.5rem;
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="section-spacing {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="benefits-list color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.image != blank %}benefits-list--with-image benefits-list--image-{{ section.settings.image_position }}{% endif %}">
      <div class="benefits-list__content">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          heading_style: section.settings.heading_style,
          content: section.settings.content,
          text_alignment: 'start'
        -%}

        {%- if section.blocks.size > 0 -%}
          <ol class="benefits-list__items" role="list">
            {%- for block in section.blocks -%}
              <li class="benefits-list__item" {{ block.shopify_attributes }}>
                {%- if section.settings.marker_style == 'icon' -%}
                  <span class="benefits-list__marker benefits-list__marker--icon" aria-hidden="true">
                    {%- render 'icon' with block.settings.icon, width: 28 -%}
                  </span>
                {%- else -%}
                  <span class="benefits-list__marker" aria-hidden="true">{{ forloop.index }}.</span>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <p class="h5">{{ block.settings.title }}</p>
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <div class="benefits-list__text prose">
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        {%- assign image_style = 'object-position: ' | append: section.settings.image.presentation.focal_point -%}

        <div class="benefits-list__media">
          {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 999px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600', style: image_style, loading: 'lazy' -}}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

