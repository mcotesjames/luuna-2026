{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LEAD FORM

  Lead capture form for campaign landing pages. Submissions use Shopify's customer form, so each lead is created (or
  updated) as a customer subscribed to email marketing, and tagged with the campaign tag so it can be segmented in the
  admin (Customers > Segments, filter by tag). Custom field blocks are saved to the customer's note.
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .lead-form {
    display: grid;
    gap: var(--spacing-10, 2.5rem);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .lead-form__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--rounded, 0);
  }

  #shopify-section-{{ section.id }} .lead-form__disclaimer {
    font-size: var(--text-xs);
    opacity: .75;
  }

  #shopify-section-{{ section.id }} .lead-form__disclaimer a {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .lead-form--with-image {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-16, 4rem);
    }

    #shopify-section-{{ section.id }} .lead-form--image-start .lead-form__media {
      order: -1;
    }
  }
</style>

{%- liquid
  assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5
  assign form_id = 'lead-form-' | append: section.id
  assign campaign_tag = section.settings.campaign_tag | strip

  assign tags = 'lead'
  if campaign_tag != blank
    assign tags = tags | append: ', ' | append: campaign_tag
  endif

  if section.settings.image != blank
    assign text_alignment = 'start'
  else
    assign text_alignment = 'center'
  endif
-%}

<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container {% if section.settings.image == blank %}container--xs{% endif %}">
    <div class="lead-form {% if section.settings.image != blank %}lead-form--with-image lead-form--image-{{ section.settings.image_position }}{% endif %}">
      <div class="section-stack text-{{ text_alignment }}">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          heading_style: section.settings.heading_style,
          content: section.settings.content,
          text_alignment: text_alignment
        -%}

        {%- form 'customer', id: form_id, class: 'form' -%}
          {%- if form.posted_successfully? -%}
            {%- render 'banner', status: 'success', content: section.settings.success_message, text_alignment: text_alignment -%}
          {%- else -%}
            {%- if form.errors -%}
              {%- capture error_message -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
              {%- render 'banner', status: 'error', content: error_message -%}
            {%- endif -%}

            <input type="hidden" name="contact[tags]" value="{{ tags | escape }}">

            {%- if section.settings.redirect_url != blank -%}
              <input type="hidden" name="return_to" value="{{ section.settings.redirect_url }}">
            {%- endif -%}

            <div class="fieldset">
              {%- if section.settings.show_name -%}
                <div class="fieldset-row">
                  {%- assign label = 'customer.register.first_name' | t -%}
                  {%- render 'input', type: 'text', name: 'contact[first_name]', label: label, value: customer.first_name, required: section.settings.require_name, autocomplete: 'given-name', id_prefix: form_id -%}

                  {%- assign label = 'customer.register.last_name' | t -%}
                  {%- render 'input', type: 'text', name: 'contact[last_name]', label: label, value: customer.last_name, required: section.settings.require_name, autocomplete: 'family-name', id_prefix: form_id -%}
                </div>
              {%- endif -%}

              {%- assign label = 'contact.form.email' | t -%}
              {%- render 'input', type: 'email', name: 'contact[email]', label: label, value: customer.email, required: true, autocomplete: 'email', id_prefix: form_id -%}

              {%- for block in section.blocks -%}
                {%- assign field_title = block.settings.title -%}

                {%- if field_title == blank -%}
                  {%- capture field_title -%}Custom field {% increment custom_field %}{%- endcapture -%}
                {%- endif -%}

                {%- capture name -%}contact[note][{{ field_title | escape }}]{%- endcapture -%}

                {%- case block.type -%}
                  {%- when 'text' -%}
                    {%- if block.settings.use_long_text -%}
                      {%- render 'input', name: name, label: field_title, required: block.settings.required, multiline: 4, id_prefix: form_id -%}
                    {%- else -%}
                      {%- render 'input', type: 'text', name: name, label: field_title, required: block.settings.required, id_prefix: form_id -%}
                    {%- endif -%}

                  {%- when 'dropdown' -%}
                    {%- if block.settings.values != blank -%}
                      {%- assign values = block.settings.values | split: ',' -%}
                      {%- render 'select', option_values: values, show_empty_value: true, name: name, label: field_title, required: block.settings.required -%}
                    {%- endif -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>

            {%- render 'button', content: section.settings.button_text, type: 'submit', stretch: true -%}

            {%- if section.settings.disclaimer != blank -%}
              <div class="lead-form__disclaimer prose">
                {{- section.settings.disclaimer -}}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="lead-form__media">
          {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 999px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600,1800,2000', class: 'lead-form__image' -}}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.lead_form.name",
  "class": "shopify-section--lead-form",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.lead_form.campaign_category"
    },
    {
      "type": "text",
      "id": "campaign_tag",
      "label": "t:sections.lead_form.campaign_tag",
      "info": "t:sections.lead_form.campaign_tag_info"
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "t:sections.lead_form.redirect_url",
      "info": "t:sections.lead_form.redirect_url_info"
    },
    {
      "type": "header",
      "content": "t:sections.lead_form.content_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Tell visitors what they'll get by signing up.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.lead_form.image_position",
      "options": [
        {
          "value": "start",
          "label": "t:sections.lead_form.image_position_options.start"
        },
        {
          "value": "end",
          "label": "t:sections.lead_form.image_position_options.end"
        }
      ],
      "default": "end"
    },
    {
      "type": "header",
      "content": "t:sections.lead_form.form_category"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "t:sections.lead_form.show_name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "require_name",
      "label": "t:sections.lead_form.require_name",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.lead_form.button_text",
      "default": "Sign up"
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "t:sections.lead_form.success_message",
      "default": "Thanks for signing up! We'll be in touch soon."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "t:sections.lead_form.disclaimer",
      "info": "t:sections.lead_form.disclaimer_info",
      "default": "<p>By signing up, you agree to receive marketing emails from us. You can unsubscribe at any time.</p>"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.lead_form.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.lead_form.blocks.text.name_label",
          "default": "Custom field"
        },
        {
          "type": "checkbox",
          "id": "use_long_text",
          "label": "t:sections.lead_form.blocks.text.use_long_text",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.lead_form.blocks.text.required",
          "default": false
        }
      ]
    },
    {
      "type": "dropdown",
      "name": "t:sections.lead_form.blocks.dropdown.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.lead_form.blocks.dropdown.name_label",
          "default": "Custom field"
        },
        {
          "type": "text",
          "id": "values",
          "label": "t:sections.lead_form.blocks.dropdown.values",
          "info": "t:sections.lead_form.blocks.dropdown.values_info",
          "default": "value 1, value 2, value 3"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.lead_form.blocks.dropdown.required",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lead_form.presets.lead_form.name",
      "category": "t:global.categories.call_to_action"
    }
  ]
}
{% endschema %}
