<cart-drawer
  id="cart-drawer"
  aria-label="{{ 'cart.general.title' | t | escape_once }}"
  class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  initial-focus="false"
  handle-editor-events
>
  <p class="h4" slot="header">{{ 'cart.general.title' | t }}</p>

  {%- if cart.empty? -%}
    <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
  {%- else -%}
    {%- if settings.cart_show_free_shipping_bar and cart.requires_shipping -%}
      {%- comment -%}Plain wrapper as the drawer's grid item, so the scrolling drawer body sizes the row to the bar{%- endcomment -%}
      <div class="cart-drawer__free-shipping-wrapper">
        {%- render 'free-shipping-progress', settings_source: section, persist: 'cart-drawer', class: 'cart-drawer__free-shipping' -%}
      </div>
    {%- endif -%}

    {%- liquid
      # Bundle & save links: products whose Bundle upsell metafield (custom.bundle_upsell) points to an available bundle
      # that isn't already in the cart. Each bundle is suggested once, under the first item that leads to it.
      assign cart_product_ids = cart.items | map: 'product_id'
      assign suggested_bundle_ids = ','
    -%}

    <div class="cart-drawer__items">
      {%- for line_item in cart.items -%}
        {%- liquid
          assign bundle_link = blank

          if section.settings.show_bundle_links
            for bundle in line_item.product.metafields.custom.bundle_upsell.value
              assign bundle_key = ',' | append: bundle.id | append: ','
              if bundle == blank or bundle.available == false or bundle.id == line_item.product_id or cart_product_ids contains bundle.id or suggested_bundle_ids contains bundle_key
                continue
              endif

              assign suggested_bundle_ids = suggested_bundle_ids | append: bundle.id | append: ','
              assign bundle_variant = bundle.selected_or_first_available_variant
              assign bundle_link_text = section.settings.bundle_link_text_no_saving

              if bundle_variant.compare_at_price > bundle_variant.price and section.settings.bundle_link_text != blank
                assign bundle_saving = bundle_variant.compare_at_price | minus: bundle_variant.price | times: 100.0 | divided_by: bundle_variant.compare_at_price | round | append: '%'
                assign bundle_link_text = section.settings.bundle_link_text | replace: '[saving]', bundle_saving
              endif

              if bundle_link_text != blank
                capture bundle_link
                  echo '<a href="' | append: bundle.url | append: '" class="cart-drawer__bundle-link">'
                  echo '<span>' | append: bundle_link_text | append: '</span>'
                  echo '<span class="sr-only">: ' | append: bundle.title | append: '</span>'
                  render 'icon' with 'arrow-right', width: 12, class: 'cart-drawer__bundle-arrow'
                  echo '</a>'
                endcapture
              endif

              break
            endfor
          endif
        -%}

        {%- render 'line-item', line_item: line_item, show_quantity_selector: true, after_content: bundle_link -%}
      {%- endfor -%}
    </div>

    {%- liquid
      assign cross_sell_products_count = 0

      for product in section.settings.cross_sell_products
        assign items_for_product = cart | line_items_for: product

        if items_for_product.size == 0 and product.available
          assign cross_sell_products_count = cross_sell_products_count | plus: 1
        endif
      endfor
    -%}

    {%- if cross_sell_products_count > 0 -%}
      <div class="cart-drawer__complementary-products complementary-products">
        {%- assign carousel_id = 'complementary-products-carousel-' | append: section.id -%}

        {%- if section.settings.cross_sell_title != blank or section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
          <div class="complementary-products__header complementary-products__header--align-start">
            <p class="h6">{{ section.settings.cross_sell_title }}</p>

            {%- if section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
              <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots page-dots--narrow">
                {%- for i in (1..cross_sell_products_count) -%}
                  <button class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          capture complementary_products
            for product in section.settings.cross_sell_products
              assign products_in_cart = cart.items | where: 'product_id', product.id

              if products_in_cart.size == 0 and product.available
                render 'product-card-horizontal', product: product, show_quick_buy: true
              endif
            endfor
          endcapture
        -%}

        {%- if section.settings.cross_sell_stack_products -%}
          <div class="complementary-products__product-list">
            {{- complementary_products -}}
          </div>
        {%- else -%}
          <scroll-carousel id="{{ carousel_id }}" class="complementary-products__product-list complementary-products__product-list--carousel scroll-area bleed snap-x">
            {{- complementary_products -}}
          </scroll-carousel>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div slot="footer">
      <form action="{{ routes.cart_url }}" class="cart-drawer__footer" method="POST">
        <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
        <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

        {%- if section.settings.show_cart_note -%}
          <div class="v-stack gap-0.5 justify-items-start">
            {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
            <button class="link-faded-reverse" aria-controls="{{ cart_note_dialog_id }}">{{ 'cart.general.add_order_note' | t }}</button>

            <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
              <div class="form">
                <cart-note class="form-control">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                </cart-note>

                <dialog-close-button class="contents">
                  <button type="button" class="button">{{ 'cart.general.save_note' | t }}</button>
                </dialog-close-button>
              </div>
            </cart-note-dialog>
          </div>
        {%- endif -%}

        {%- render 'discount-code-message',
          discount_code: section.settings.discount_message_code,
          text: section.settings.discount_message_text,
          applied_text: section.settings.discount_message_applied_text,
          class: 'w-full'
        -%}

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="h-stack gap-3">
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="h-stack justify-start gap-4">
                <span class="discount-badge text-xs">
                  {%- render 'icon' with 'discount', width: 12 -%}
                  {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <button type="submit" name="checkout" class="button w-full cart-drawer__checkout">
          {%- render 'icon' with 'cart', width: 18, class: 'cart-drawer__checkout-icon' -%}
          <span>{{ 'cart.general.checkout' | t }}</span>

          {%- if section.settings.show_price_in_checkout_button -%}
            <span class="cart-drawer__button-price">{{- cart.total_price | money -}}</span>
          {%- endif -%}
        </button>

        {%- if section.settings.checkout_disclaimer != blank -%}
          <p class="cart-drawer__disclaimer text-xs text-subdued">{{ section.settings.checkout_disclaimer }}</p>
        {%- endif -%}
      </form>
    </div>
  {%- endif -%}
</cart-drawer>

{% stylesheet %}
  /* Checkout is the only action in the drawer footer, so it gets more weight than a standard button.
     Section styles load before theme.css, so these selectors need to outrank the theme's .button rules. */
  .cart-drawer .button.cart-drawer__checkout {
    min-height: 3.5rem;
    padding-block: 1rem;
    column-gap: 0.75rem;
    /* Brand display font (loaded in layout/theme.liquid), set like the headings and purchase option titles */
    font-family: 'Adelia', serif;
    font-size: var(--text-base, 1rem);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    box-shadow: 0 6px 16px -8px rgb(var(--button-background) / 0.6);
  }

  .cart-drawer .cart-drawer__checkout-icon {
    flex-shrink: 0;
    margin-block-start: -2px;
  }

  /* Bundle & save link under a line item */
  .cart-drawer .cart-drawer__bundle-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .cart-drawer .cart-drawer__bundle-arrow {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .cart-drawer .cart-drawer__bundle-link:hover .cart-drawer__bundle-arrow {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer .cart-drawer__bundle-arrow { transition: none; }
  }

  .cart-drawer .cart-drawer__disclaimer {
    justify-self: center;
    text-align: center;
    margin-block-start: -0.25rem;
  }

  .cart-drawer .cart-drawer__checkout .cart-drawer__button-price::before {
    margin-inline-end: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.page_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.free_shipping_bar_info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.cart_drawer.show_cart_note",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "checkout_disclaimer",
      "label": "Note below checkout button",
      "info": "Leave blank to hide.",
      "default": "Shipping, taxes and discount codes are applied at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_price_in_checkout_button",
      "label": "t:sections.cart_drawer.show_price_in_checkout_button",
      "default": true
    },
    {
      "type": "header",
      "content": "Free shipping progress",
      "info": "Shown when the free shipping bar is turned on in Theme settings > Cart, where the minimum amount is set."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "minimal", "label": "Minimal" },
        { "value": "card", "label": "Cream card" },
        { "value": "bold", "label": "Espresso card" }
      ],
      "default": "minimal"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show delivery icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate",
      "info": "The bar fills as the cart changes, and the delivery truck pulses when free shipping is unlocked. Off for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "message_away",
      "label": "Below the minimum",
      "info": "[amount] is replaced with the amount left to spend.",
      "default": "You're [amount] away from free shipping"
    },
    {
      "type": "inline_richtext",
      "id": "message_cart_reached",
      "label": "Minimum reached",
      "default": "Your order qualifies for <strong>free shipping</strong>"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Bar",
      "info": "Leave the colours blank to use the style's colours."
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Bar background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background"
    },
    {
      "type": "header",
      "content": "Bundle & save links",
      "info": "A short link under cart items whose product has a bundle in its Bundle upsell metafield, leading to the bundle page. Hidden when the bundle is already in the cart or unavailable."
    },
    {
      "type": "checkbox",
      "id": "show_bundle_links",
      "label": "Show bundle links",
      "default": true
    },
    {
      "type": "text",
      "id": "bundle_link_text",
      "label": "Link text",
      "info": "[saving] is replaced with the percentage saved, from the bundle's compare-at price.",
      "default": "Bundle & save [saving]"
    },
    {
      "type": "text",
      "id": "bundle_link_text_no_saving",
      "label": "Link text without a saving",
      "info": "Used when the bundle has no compare-at price. Leave blank to show no link for those bundles.",
      "default": "Get it in a bundle"
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.discount_message_category"
    },
    {
      "type": "text",
      "id": "discount_message_code",
      "label": "t:sections.cart_drawer.discount_message_code",
      "info": "t:sections.cart_drawer.discount_message_code_info",
      "default": "FREESHIPPING"
    },
    {
      "type": "inline_richtext",
      "id": "discount_message_text",
      "label": "t:sections.cart_drawer.discount_message_text",
      "info": "t:sections.cart_drawer.discount_message_text_info",
      "default": "Want this delivery on us? Use FREESHIPPING at checkout"
    },
    {
      "type": "inline_richtext",
      "id": "discount_message_applied_text",
      "label": "t:sections.cart_drawer.discount_message_applied_text",
      "info": "t:sections.cart_drawer.discount_message_applied_text_info",
      "default": "FREESHIPPING applied. Free delivery will show at checkout"
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.cross_sell_category"
    },
    {
      "type": "product_list",
      "id": "cross_sell_products",
      "label": "t:sections.cart_drawer.cross_sell_products",
      "info": "t:sections.cart_drawer.cross_sell_products_info",
      "limit": 5
    },
    {
      "type": "inline_richtext",
      "id": "cross_sell_title",
      "label": "t:sections.cart_drawer.cross_sell_heading",
      "default": "Complete with",
      "visible_if": "{{ section.settings.cross_sell_products != blank }}"
    },
    {
      "type": "checkbox",
      "id": "cross_sell_stack_products",
      "label": "t:sections.cart_drawer.cross_sell_stack_products",
      "default": false,
      "visible_if": "{{ section.settings.cross_sell_products != blank }}"
    }
  ]
}
{% endschema %}
