            "logo_mobile_max_width": 100,
            "author": "Priya M., Mid-Levels"
          }
        },
        "testimonial_KVxqj8": {
          "type": "testimonial",
          "settings": {
            "content": "<p>\"I had no idea plastic were so widespread in my period care. Switching to organic has stopped the irritations i've had for years. I'll never go back.\"</p>",
            "logo_max_width": 140,
