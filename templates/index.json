      "blocks": {
        "testimonial_hexKWz": {
          "type": "testimonial",
          "settings": {
            "content": "<p>\"I love knowing my order supports girls and women who don't have access. It's rare to find somewhere to shop where your spend actually goes somewhere real.\"</p>",
